{
  "openapi": "3.1.0",
  "info": {
    "title": "SABZ Edge Bench API",
    "version": "0.1.0",
    "description": "Single intersection, two through-only phases, emulator outputs only. Not field certified."
  },
  "paths": {
    "/v1/observations": {
      "post": {
        "summary": "Accept an observation; never directly actuates a signal",
        "security": [
          {
            "cameraBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Observation"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Durably accepted sequence; bench only"
          },
          "400": {
            "description": "Invalid observation or framing"
          },
          "401": {
            "description": "Unauthorized"
          },
          "408": {
            "description": "Read timeout"
          },
          "409": {
            "description": "Sequence replayed or capture time regressed"
          },
          "413": {
            "description": "Body over 4096 bytes"
          },
          "415": {
            "description": "JSON required"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Storage fault"
          },
          "431": {
            "description": "Aggregate headers too large"
          },
          "414": {
            "description": "Request line too large"
          }
        }
      }
    },
    "/v1/status": {
      "get": {
        "security": [
          {
            "readerBearer": []
          }
        ],
        "summary": "Bench telemetry",
        "responses": {
          "200": {
            "description": "Status; field_ready is always false"
          },
          "401": {
            "description": "Unauthorized"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Not ready (readyz only)"
          }
        }
      }
    },
    "/v1/preemption": {
      "post": {
        "security": [
          {
            "readerBearer": []
          }
        ],
        "summary": "Request a phase for an emergency vehicle on one approach (explicit request, never auto-detection)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "approach"
                ],
                "properties": {
                  "approach": {
                    "type": "string",
                    "enum": [
                      "N",
                      "S",
                      "E",
                      "W"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Request recorded; safety kernel still enforces yellow/all-red clearance, 60 s expiry and latched faults"
          },
          "400": {
            "description": "Malformed body or unknown approach"
          },
          "401": {
            "description": "Unauthorized"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "security": [
          {
            "readerBearer": []
          }
        ],
        "summary": "Bench readiness, not field approval",
        "responses": {
          "200": {
            "description": "Status; field_ready is always false"
          },
          "401": {
            "description": "Unauthorized"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Not ready (readyz only)"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Minimal control-loop liveness",
        "security": [],
        "responses": {
          "200": {
            "description": "Loop alive and recent"
          },
          "503": {
            "description": "Loop unavailable"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/v1/metrics": {
      "get": {
        "security": [
          {
            "readerBearer": []
          }
        ],
        "summary": "Local dashboard view: latest metric stream, controller snapshot and recent transitions",
        "responses": {
          "200": {
            "description": "Snapshot with mode, sensor age/freshness, loop health, controller, metrics (null before the first feed) and the last 20 transition_intent events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "control_lock_busy: control loop held the lock; retry"
          },
          "401": {
            "description": "Unauthorized"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/v1/telemetry": {
      "post": {
        "security": [
          {
            "cameraBearer": []
          }
        ],
        "summary": "Counts-only dashboard feed (schema v1 semantics, metric dictionaries empty)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "counts",
                  "conflict_clear",
                  "healthy"
                ],
                "properties": {
                  "counts": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "N",
                      "S",
                      "E",
                      "W"
                    ],
                    "properties": {
                      "N": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "S": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "E": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "W": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100
                      }
                    }
                  },
                  "conflict_clear": {
                    "type": "boolean"
                  },
                  "healthy": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted; returns accepted_sequence"
          },
          "400": {
            "description": "Malformed body, wrong counts keys or non-boolean flags"
          },
          "401": {
            "description": "Unauthorized"
          },
          "409": {
            "description": "Sequence replayed"
          },
          "413": {
            "description": "Body size limit"
          },
          "415": {
            "description": "application/json required"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cameraBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Producer-only credential"
      },
      "readerBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Telemetry-only credential"
      }
    },
    "schemas": {
      "Observation": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ObservationV1"
          },
          {
            "$ref": "#/components/schemas/ObservationV2"
          }
        ]
      },
      "ObservationV1": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "sequence",
          "captured_at",
          "counts",
          "conflict_clear",
          "healthy"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1
          },
          "sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "captured_at": {
            "type": "number",
            "description": "Unix UTC seconds: no older than 3 seconds; at most 1 second in future"
          },
          "counts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "N",
              "S",
              "E",
              "W"
            ],
            "properties": {
              "N": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "S": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "E": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "W": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "conflict_clear": {
            "type": "boolean"
          },
          "healthy": {
            "type": "boolean"
          }
        }
      },
      "ObservationV2": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "sequence",
          "captured_at",
          "counts",
          "conflict_clear",
          "healthy",
          "downstream_counts",
          "downstream_capacity",
          "approaching",
          "arrival_rate",
          "oldest_wait_s"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 2
          },
          "sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "captured_at": {
            "type": "number",
            "description": "Unix UTC seconds: no older than 3 seconds; at most 1 second in future"
          },
          "counts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "N",
              "S",
              "E",
              "W"
            ],
            "properties": {
              "N": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "S": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "E": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "W": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "conflict_clear": {
            "type": "boolean"
          },
          "healthy": {
            "type": "boolean"
          },
          "downstream_counts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "N",
              "S",
              "E",
              "W"
            ],
            "properties": {
              "N": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "S": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "E": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "W": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "downstream_capacity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "N",
              "S",
              "E",
              "W"
            ],
            "properties": {
              "N": {
                "type": "number",
                "minimum": 1,
                "maximum": 100
              },
              "S": {
                "type": "number",
                "minimum": 1,
                "maximum": 100
              },
              "E": {
                "type": "number",
                "minimum": 1,
                "maximum": 100
              },
              "W": {
                "type": "number",
                "minimum": 1,
                "maximum": 100
              }
            }
          },
          "approaching": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "N",
              "S",
              "E",
              "W"
            ],
            "properties": {
              "N": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "S": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "E": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "W": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "arrival_rate": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "N",
              "S",
              "E",
              "W"
            ],
            "properties": {
              "N": {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              },
              "S": {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              },
              "E": {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              },
              "W": {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              }
            }
          },
          "oldest_wait_s": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "N",
              "S",
              "E",
              "W"
            ],
            "properties": {
              "N": {
                "type": "number",
                "minimum": 0,
                "maximum": 3600
              },
              "S": {
                "type": "number",
                "minimum": 0,
                "maximum": 3600
              },
              "E": {
                "type": "number",
                "minimum": 0,
                "maximum": 3600
              },
              "W": {
                "type": "number",
                "minimum": 0,
                "maximum": 3600
              }
            }
          }
        }
      }
    }
  }
}
